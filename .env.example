# Copy to .env to change any of these. Every one has a default, so a clean
# clone runs without this file.

# The one port the stack publishes. Change it if 3000 is taken.
STACK_PORT=3000

GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=admin

# Set this when the stack is reached under a different host than
# localhost:STACK_PORT (a reverse proxy, a public domain) — Grafana Live
# checks a websocket's Origin against it.
# GF_SERVER_ROOT_URL=https://grafana.example.org/

# Bearer token the MCP server on 127.0.0.1:8000 asks callers for.
PACHA_MCP_TOKEN=pacha-local

# Tag of the pacha images that compose builds or pulls.
STACK_VERSION=dev

# compose.dev.yaml only: a built Kepler panel to mount over the baked one.
# KEPLER_DIST=../kepler-grafana/dist

# Where the Kepler panel comes from. release (the default): the version pinned
# in images/grafana/Dockerfile. edge: main of the Kepler repo, as its CI last
# published it — not pinned, and `docker compose up -d --build` picks up
# whatever main is now. Remove the line and run `docker compose up -d --build`
# again to go back to release — both channels share one image tag, so only a
# rebuild switches it.
# KEPLER_PANEL_CHANNEL=edge

# Git Sync. local (the default, dev): Grafana syncs with this clone's
# dashboards/ and plus/dashboards/, and a save lands in the working tree; run
# scripts/dev-acl.sh once so Grafana may write there. github (public
# instances): Grafana syncs with main on GitHub, and a save is a commit there,
# signed with the Grafana user's name. Keep one type per instance: changing
# it in place needs a new token.
# PACHA_REPO_TYPE=github
# PACHA_GIT_URL=https://github.com/ubica-ecuador/pacha
# PACHA_GIT_BRANCH=main
# Fine-grained token: Contents read and write on ubica-ecuador/pacha only.
# PACHA_GIT_TOKEN=
