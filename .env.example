# Copy to .env to change any of these. Every one has a default, so a clean
# clone runs without this file.

# The one port the stack publishes. Change it if 3000 is taken.
STACK_PORT=3000

GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=admin

# Bearer token the MCP server on 127.0.0.1:8000 asks callers for.
GEOSTACK_MCP_TOKEN=geostack-local

# Tag of the geostack images that compose builds or pulls.
STACK_VERSION=dev

# compose.dev.yaml only: a built Kepler panel to mount over the baked one.
# KEPLER_DIST=../kepler-grafana/dist
