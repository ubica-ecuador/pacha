# Copy to .env to change any of these. Every one has a default, so a clean
# clone runs without this file.

# The one port the stack publishes. Change it if 3000 is taken.
STACK_PORT=3000

GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=admin

# Set this when the stack is reached under a different host than
# localhost:STACK_PORT (a reverse proxy, a public domain) — Grafana Live
# checks a websocket's Origin against it.
# GF_SERVER_ROOT_URL=https://grafana.example.org/

# Bearer token the MCP server on 127.0.0.1:8000 asks callers for.
PACHA_MCP_TOKEN=pacha-local

# Tag of the pacha images that compose builds or pulls.
STACK_VERSION=dev

# compose.dev.yaml only: a built Kepler panel to mount over the baked one.
# KEPLER_DIST=../kepler-grafana/dist
