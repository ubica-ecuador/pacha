        "kind": "Panel",
        "spec": {
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "hidden": false,
                    "query": {
                      "datasource": {
                        "name": "duckdb"
                      },
                      "group": "motherduck-duckdb-datasource",
                      "kind": "DataQuery",
                      "spec": {
                        "format": 1,
                        "rawQuery": true,
                        "rawSql": "WITH b AS (\n  SELECT bin, height_roof,\n         ST_Transform(ST_Centroid(geometry), 'EPSG:4326', 'EPSG:32618', always_xy := true) AS pt,\n         ST_Area(ST_Transform(geometry, 'EPSG:4326', 'EPSG:32618', always_xy := true)) AS footprint_m2\n  FROM read_parquet('http://feeds/geolens/datasets/4a0bd0db-cd92-424a-8a2e-62d270ae918a.parquet')\n  WHERE height_roof \u003e= CAST($minHeight AS DOUBLE)\n    AND era IN (${era:singlequote})\n), s AS (\n  SELECT stop_name, daytime_routes, borough, ada,\n         ST_Transform(geometry, 'EPSG:4326', 'EPSG:32618', always_xy := true) AS pt\n  FROM read_parquet('http://feeds/geolens/datasets/c646ff35-82eb-442f-a524-efcbb1645023.parquet')\n)\nSELECT\n  s.stop_name AS \"Station\",\n  s.daytime_routes AS \"Routes\",\n  CASE s.borough WHEN 'M' THEN 'Manhattan' WHEN 'Bk' THEN 'Brooklyn'\n                 WHEN 'Bx' THEN 'Bronx'    WHEN 'Q'  THEN 'Queens'\n                 WHEN 'SI' THEN 'Staten Island' END AS \"Borough\",\n  CASE s.ada WHEN 1 THEN 'Full' WHEN 2 THEN 'Partial' ELSE 'None' END AS \"Step-free\",\n  count(b.bin) AS \"Buildings\",\n  round(max(b.height_roof)) AS \"Tallest (ft)\",\n  round(sum(b.footprint_m2)) AS \"Footprint (m2)\"\nFROM s LEFT JOIN b ON ST_DWithin(s.pt, b.pt, CAST($radius AS DOUBLE))\nGROUP BY 1, 2, 3, 4\nHAVING count(b.bin) \u003e 0\nORDER BY 5 DESC"
                      },
                      "version": "v0"
                    },
                    "refId": "A"
                  }
                }
              ],
              "queryOptions": {},
              "transformations": []
            }
          },
          "description": "Buildings whose centre falls within $radius m of the station, and what they add up to.",
          "id": 4,
          "links": [],
          "title": "Stations, by how much of the city they stand in",
          "vizConfig": {
            "group": "table",
            "kind": "VizConfig",
            "spec": {
              "fieldConfig": {
                "defaults": {
                  "custom": {
                    "align": "auto",
