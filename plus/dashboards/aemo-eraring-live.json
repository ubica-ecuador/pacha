      "panel-6": {
        "kind": "Panel",
        "spec": {
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "hidden": false,
                    "query": {
                      "datasource": {
                        "name": "duckdb"
                      },
                      "group": "motherduck-duckdb-datasource",
                      "kind": "DataQuery",
                      "spec": {
                        "format": 1,
                        "rawQuery": true,
                        "rawSql": "-- What each unit did over the time range, from its output each interval:\n-- off, low load (under half), running, full load (90 % and more).\nSELECT ts AS time,\n       CASE WHEN max(mw) FILTER (WHERE duid = 'ER01') IS NULL THEN 'No reading' WHEN max(mw) FILTER (WHERE duid = 'ER01') \u003c 10 THEN 'Offline' WHEN max(mw) FILTER (WHERE duid = 'ER01') \u003c 360.0 THEN 'Low load' WHEN max(mw) FILTER (WHERE duid = 'ER01') \u003c 648.0 THEN 'Running' ELSE 'Full load' END AS \"Unit 1\",\n       CASE WHEN max(mw) FILTER (WHERE duid = 'ER02') IS NULL THEN 'No reading' WHEN max(mw) FILTER (WHERE duid = 'ER02') \u003c 10 THEN 'Offline' WHEN max(mw) FILTER (WHERE duid = 'ER02') \u003c 360.0 THEN 'Low load' WHEN max(mw) FILTER (WHERE duid = 'ER02') \u003c 648.0 THEN 'Running' ELSE 'Full load' END AS \"Unit 2\",\n       CASE WHEN max(mw) FILTER (WHERE duid = 'ER03') IS NULL THEN 'No reading' WHEN max(mw) FILTER (WHERE duid = 'ER03') \u003c 10 THEN 'Offline' WHEN max(mw) FILTER (WHERE duid = 'ER03') \u003c 360.0 THEN 'Low load' WHEN max(mw) FILTER (WHERE duid = 'ER03') \u003c 648.0 THEN 'Running' ELSE 'Full load' END AS \"Unit 3\",\n       CASE WHEN max(mw) FILTER (WHERE duid = 'ER04') IS NULL THEN 'No reading' WHEN max(mw) FILTER (WHERE duid = 'ER04') \u003c 10 THEN 'Offline' WHEN max(mw) FILTER (WHERE duid = 'ER04') \u003c 360.0 THEN 'Low load' WHEN max(mw) FILTER (WHERE duid = 'ER04') \u003c 648.0 THEN 'Running' ELSE 'Full load' END AS \"Unit 4\"\nFROM read_parquet([${files:singlequote}])\nWHERE duid LIKE 'ER0_' AND ts BETWEEN $__timeFrom() AND $__timeTo()\nGROUP BY ts\nORDER BY ts\n"
                      },
                      "version": "v0"
                    },
                    "refId": "A"
                  }
                }
              ],
              "queryOptions": {},
              "transformations": []
            }
