      "panel-3": {
        "kind": "Panel",
        "spec": {
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "hidden": false,
                    "query": {
                      "datasource": {
                        "name": "duckdb"
                      },
                      "group": "motherduck-duckdb-datasource",
                      "kind": "DataQuery",
                      "spec": {
                        "format": 1,
                        "rawQuery": true,
                        "rawSql": "-- Each unit's latest reading and what it is doing. Every row carries the\n-- model's origin (datasets/eraring/build.sh), which places it; duid names\n-- the unit's part of model.glb. The reading is text, not a time, so the map's\n-- time settings leave the units alone.\nWITH latest AS (\n  SELECT duid, arg_max(mw, ts) AS mw, max(ts) AS ts\n  FROM read_parquet([${files:singlequote}])\n  WHERE duid IN ('ER01', 'ER02', 'ER03', 'ER04')\n  GROUP BY duid\n)\nSELECT u.duid, u.name, round(coalesce(l.mw, 0), 1) AS mw,\n       round(100 * greatest(coalesce(l.mw, 0), 0) / u.capacity_mw) AS load_pct,\n       CASE WHEN l.mw IS NULL THEN 'No reading' WHEN l.mw \u003c 10 THEN 'Offline' WHEN l.mw \u003c 360.0 THEN 'Low load' WHEN l.mw \u003c 648.0 THEN 'Running' ELSE 'Full load' END AS state,\n       strftime(make_timestamp(epoch_us(l.ts) + 36000000000), '%-d %b %H:%M AEST') AS reading,\n       u.origin_latitude AS latitude, u.origin_longitude AS longitude\nFROM 'http://feeds/datasets/eraring/units.parquet' u LEFT JOIN latest l USING (duid)\nORDER BY u.duid\n"
                      },
                      "version": "v0"
                    },
                    "refId": "A"
                  }
                },
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "hidden": false,
                    "query": {
                      "datasource": {
                        "name": "duckdb"
                      },
                      "group": "motherduck-duckdb-datasource",
                      "kind": "DataQuery",
                      "spec": {
                        "format": 1,
                        "rawQuery": true,
                        "rawSql": "-- Each unit's output every five minutes over the time range, for its card on\n-- the map: a dot over its part of the block (units.parquet), at the height of\n-- its boiler house, coloured by its output now, and its series on hover.\nSELECT r.ts AS time, u.duid, replace(u.name, 'Eraring unit', 'Unit') AS name,\n       u.latitude, u.longitude, 75 AS altitude, round(r.mw) AS mw\nFROM read_parquet([${files:singlequote}]) r\nJOIN 'http://feeds/datasets/eraring/units.parquet' u USING (duid)\nWHERE r.ts BETWEEN $__timeFrom() AND $__timeTo()\nORDER BY u.duid, r.ts\n"
                      },
                      "version": "v0"
                    },
                    "refId": "B"
                  }
                }
              ],
              "queryOptions": {},
              "transformations": []
            }
          },
          "description": "The station in 3D on its satellite image; each unit coloured by its latest SCADA reading, with a dot over it and its output over the range on its card.",
