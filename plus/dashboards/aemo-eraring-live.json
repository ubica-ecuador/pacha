                              "value": null
                            },
                            {
                              "color": "orange",
                              "value": 15
                            },
                            {
                              "color": "red",
                              "value": 60
                            }
                          ]
                        }
                      }
                    ]
                  }
                ]
              },
              "options": {
                "colorMode": "value",
                "graphMode": "none",
                "justifyMode": "center",
                "orientation": "vertical",
                "reduceOptions": {
                  "calcs": [
                    "lastNotNull"
                  ],
                  "fields": "/.*/",
                  "values": false
                },
                "textMode": "value_and_name"
              }
            },
            "version": ""
          }
        }
