      "panel-4": {
        "kind": "Panel",
        "spec": {
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "hidden": false,
                    "query": {
                      "datasource": {
                        "name": "duckdb"
                      },
                      "group": "motherduck-duckdb-datasource",
                      "kind": "DataQuery",
                      "spec": {
                        "format": 1,
                        "rawQuery": true,
                        "rawSql": "-- Each unit's latest output against its 720 MW.\nWITH latest AS (\n  SELECT duid, arg_max(mw, ts) AS mw, max(ts) AS ts\n  FROM read_parquet([${files:singlequote}])\n  WHERE duid IN ('ER01', 'ER02', 'ER03', 'ER04')\n  GROUP BY duid\n)\nSELECT round(greatest(max(mw) FILTER (WHERE duid = 'ER01'), 0)) AS \"Unit 1\",\n       round(greatest(max(mw) FILTER (WHERE duid = 'ER02'), 0)) AS \"Unit 2\",\n       round(greatest(max(mw) FILTER (WHERE duid = 'ER03'), 0)) AS \"Unit 3\",\n       round(greatest(max(mw) FILTER (WHERE duid = 'ER04'), 0)) AS \"Unit 4\"\nFROM latest\n"
                      },
                      "version": "v0"
                    },
                    "refId": "A"
                  }
