                "spec": "# How high the humid air goes: voxels per pressure level, each drawn over the\n# layer of air it stands for. Brush a range of heights (low cloud, the\n# outflow) to keep it on the map and in the other charts.\nparams:\n  cloudFilters: { select: crossfilter }\nplot:\n  - mark: rectX\n    data: { from: clouds, filterBy: $cloudFilters }\n    y1: band_lo_km\n    y2: band_hi_km\n    x: { count: }\n    fill: height_class\n    inset: 0.5\n  - select: intervalY\n    as: $cloudFilters\n    field: height_km\n    brush: { fillOpacity: 0.08, stroke: currentColor, strokeOpacity: 0.7 }\nyDomain: [0, 14.5]\ncolorDomain: [\"Below 2 km\", \"2–5 km\", \"5–8 km\", \"8–11 km\", \"Above 11 km\"]\ncolorRange: [\"#5b5bd6\", \"#3fa7d6\", \"#59d4a8\", \"#f2c14e\", \"#fff4d6\"]\nxLabel: Voxels →\nyLabel: ↑ Height (km)\nmarginLeft: 40\nmarginBottom: 36\n",
                "variables": "- param: cloudFilters\n  column: height_km\n  from: h_lo\n  to: h_hi\n"
              }
