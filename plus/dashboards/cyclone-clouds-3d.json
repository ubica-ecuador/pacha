      {
        "kind": "QueryVariable",
        "spec": {
          "allowCustomValue": true,
          "current": {
            "text": "",
            "value": ""
          },
          "hide": "hideVariable",
          "includeAll": false,
          "multi": false,
          "name": "clouds",
          "options": [],
          "query": {
            "datasource": {
              "name": "duckdbwasm"
            },
            "group": "ubica-chaski-datasource",
            "kind": "DataQuery",
            "spec": {
              "kind": "dataset",
              "name": "clouds",
              "refId": "clouds",
              "source": {
                "datasource": {
                  "type": "motherduck-duckdb-datasource",
                  "uid": "duckdb"
                },
                "query": {
                  "datasource": {
                    "type": "motherduck-duckdb-datasource",
                    "uid": "duckdb"
                  },
                  "editorMode": "code",
                  "format": 1,
                  "rawQuery": true,
                  "rawSql": "-- ECMWF's forecast (IFS, 0.25 degree, Open Data, the run of 29 October 18 UTC)\n-- of relative humidity on eleven pressure levels, every six hours to two days\n-- ahead: the cells and levels at 90 % or more within 1,000 km of In-fa's eye,\n-- into the browser once. The eye of each step is the model's own, its lowest\n-- sea-level pressure near the track (centres.parquet). Each voxel carries its\n-- distance and bearing from the eye and the height of its level in the\n-- standard atmosphere. Each step is stamped three hours before its valid time,\n-- the middle of the six-hour window that ends at it, so the brush's window\n-- holds one step: the one valid at its end.\nWITH v AS (\n  SELECT v.valid_time, v.latitude, v.longitude, v.level_hpa, v.rh,\n         c.msl_hpa AS eye_hpa,\n         2 * 6371 * asin(sqrt(pow(sin(radians(v.latitude - c.latitude) / 2), 2)\n             + cos(radians(c.latitude)) * cos(radians(v.latitude)) * pow(sin(radians(v.longitude - c.longitude) / 2), 2))) AS distance_km,\n         (degrees(atan2(sin(radians(v.longitude - c.longitude)) * cos(radians(v.latitude)),\n                        cos(radians(c.latitude)) * sin(radians(v.latitude))\n                        - sin(radians(c.latitude)) * cos(radians(v.latitude)) * cos(radians(v.longitude - c.longitude)))) + 360) % 360 AS bearing\n  FROM 'http://feeds/datasets/cyclone-clouds/clouds.parquet' v\n  JOIN 'http://feeds/datasets/cyclone-clouds/centres.parquet' c USING (valid_time)\n  WHERE v.rh \u003e= 90\n)\nSELECT valid_time - INTERVAL 3 HOUR AS time,\n       strftime(valid_time, '%b %-d %H:%M UTC') AS valid_at,\n       latitude, longitude, level_hpa,\n       rh AS humidity_pct,\n       round(44330.8 * (1 - pow(level_hpa / 1013.25, 0.190263)) / 1000, 1) AS height_km,\n       round(distance_km) AS distance_km,\n       round(bearing) AS bearing_deg,\n       eye_hpa,\n       -- The height band each chart and the map colour by.\n       CASE WHEN level_hpa \u003e= 850 THEN 'Below 2 km' WHEN level_hpa \u003e= 600 THEN '2–5 km'\n            WHEN level_hpa \u003e= 400 THEN '5–8 km' WHEN level_hpa \u003e= 250 THEN '8–11 km'\n            ELSE 'Above 11 km' END AS height_class,\n       -- The share of its 25 km ring around the eye one cell covers (a 0.25\n       -- degree cell against the ring's area), so a sum per ring and level is\n       -- the share of that ring that is humid, near the eye as far out.\n       27.8 * 27.8 * cos(radians(latitude))\n         / (pi() * (pow(floor(distance_km / 25) * 25 + 25, 2) - pow(floor(distance_km / 25) * 25, 2))) AS ring_share,\n       -- The layer of air this level stands for, halfway to its neighbours.\n       CASE level_hpa WHEN 1000 THEN 0 WHEN 925 THEN 0.45 WHEN 850 THEN 1.15 WHEN 700 THEN 2.25 WHEN 600 THEN 3.6\n                      WHEN 500 THEN 4.9 WHEN 400 THEN 6.4 WHEN 300 THEN 8.2 WHEN 250 THEN 9.8 WHEN 200 THEN 11.1\n                      ELSE 12.7 END AS band_lo_km,\n       CASE level_hpa WHEN 1000 THEN 0.45 WHEN 925 THEN 1.15 WHEN 850 THEN 2.25 WHEN 700 THEN 3.6 WHEN 600 THEN 4.9\n                      WHEN 500 THEN 6.4 WHEN 400 THEN 8.2 WHEN 300 THEN 9.8 WHEN 250 THEN 11.1 WHEN 200 THEN 12.7\n                      ELSE 14.5 END AS band_hi_km\nFROM v\nWHERE distance_km \u003c= 1000\nORDER BY time\n",
                  "refId": "clouds"
                },
                "type": "datasource"
              }
            },
            "version": "v0"
          },
          "refresh": "onDashboardLoad",
          "regex": "",
          "regexApplyTo": "value",
          "skipUrlSync": true,
          "sort": "disabled"
        }
