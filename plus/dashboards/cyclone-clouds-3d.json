      "panel-3": {
        "kind": "Panel",
        "spec": {
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "hidden": false,
                    "query": {
                      "datasource": {
                        "name": "duckdbwasm"
                      },
                      "group": "ubica-chaski-datasource",
                      "kind": "DataQuery",
                      "spec": {
                        "rawSql": "-- Humid air in each step: how many voxels pass the threshold and\n-- the brushes of the charts (grey behind: all of them). Not filtered by its own window.\nWITH x AS (\n  SELECT time, level_hpa, $__crossfilter($cloudFilters, -time) AS keep FROM $clouds\n)\nSELECT time_bucket(INTERVAL 6 HOUR, time) AS time,\n       count(*)::DOUBLE AS \"All humid air\",\n       count(*) FILTER (WHERE keep)::DOUBLE AS \"Kept by the charts\"\nFROM x\nGROUP BY 1\nORDER BY 1\n",
                        "refId": "A"
                      },
                      "version": "v0"
                    },
                    "refId": "A"
                  }
                }
              ],
              "queryOptions": {},
              "transformations": []
            }
          },
          "description": "Bars: voxels at or above the threshold in each step, below and above 5.5 km (500 hPa).",
          "id": 3,
          "links": [],
          "title": "Forecast hours: brush or press play, one six-hour step at a time",
          "vizConfig": {
            "group": "ubica-timebrush-panel",
            "kind": "VizConfig",
            "spec": {
