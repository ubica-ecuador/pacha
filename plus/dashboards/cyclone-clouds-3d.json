      "panel-4": {
        "kind": "Panel",
        "spec": {
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [],
              "queryOptions": {},
              "transformations": []
            }
          },
          "description": "Humid air by distance from the model’s eye (25 km rings) and height, every bearing together, in the colour of its height: the more of the ring at or above the threshold, the more opaque. Brush a range of distance to filter.",
          "id": 4,
          "links": [],
          "title": "In-fa from the side: distance from the eye and height",
          "vizConfig": {
            "group": "ubica-chaski-mosaic-panel",
            "kind": "VizConfig",
            "spec": {
              "fieldConfig": {
                "defaults": {},
                "overrides": []
              },
              "options": {
                "preaggregate": true,
                "reads": "",
                "spec": "# In-fa from the side: the share of each 25 km ring around the eye (the model's\n# lowest pressure) that is humid, level by level, every bearing together, at the\n# step the brush shows: in the colour of its height, more opaque the more of\n# the ring is humid.\n# The eye is the gap at the left; the eyewall the tall column beside it. Brush\n# a range of distance (the eyewall, the outer bands) to keep that ring on the\n# map and in the other charts.\nparams:\n  cloudFilters: { select: crossfilter }\nplot:\n  - mark: rect\n    data: { from: clouds, filterBy: $cloudFilters }\n    x: { bin: distance_km, step: 25 }\n    y1: band_lo_km\n    y2: band_hi_km\n    fill: height_class\n    fillOpacity: { sum: ring_share }\n    inset: 0\n  - select: intervalX\n    as: $cloudFilters\n    brush: { fillOpacity: 0.06, stroke: currentColor, strokeOpacity: 0.8 }\nxDomain: [0, 1000]\nyDomain: [0, 14.5]\ncolorDomain: [\"Below 2 km\", \"2–5 km\", \"5–8 km\", \"8–11 km\", \"Above 11 km\"]\ncolorRange: [\"#5b5bd6\", \"#3fa7d6\", \"#59d4a8\", \"#f2c14e\", \"#fff4d6\"]\nopacityDomain: [0, 0.7]\nopacityClamp: true\nxLabel: Distance from the eye (km) →\nyLabel: ↑ Height (km)\nmarginLeft: 40\nmarginBottom: 36\n",
                "variables": "- param: cloudFilters\n  column: distance_km\n  from: dist_lo\n  to: dist_hi\n"
              }
            },
            "version": "2.3.1"
          }
        }
      },
      "panel-5": {
        "kind": "Panel",
        "spec": {
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [],
              "queryOptions": {},
              "transformations": []
            }
          },
          "description": "Voxels by bearing from the eye, eight sectors, stacked by height. Brush a range of bearings to filter.",
          "id": 5,
          "links": [],
          "title": "Side of the eye",
          "vizConfig": {
            "group": "ubica-chaski-mosaic-panel",
            "kind": "VizConfig",
            "spec": {
              "fieldConfig": {
                "defaults": {},
                "overrides": []
              },
              "options": {
                "preaggregate": true,
                "reads": "- param: cloudFilters\n  column: humidity_pct\n  from: rh\n  to: rh_top\n",
                "spec": "# Which side of the eye holds the humid air: bearing from the eye, 0 = north,\n# in eight sectors, stacked by height, at the step the brush shows. Brush a\n# range of bearings.\nparams:\n  cloudFilters: { select: crossfilter }\nplot:\n  - mark: rectY\n    data: { from: clouds, filterBy: $cloudFilters }\n    x: { bin: bearing_deg, step: 45 }\n    y: { count: }\n    fill: height_class\n    inset: 1\n  - select: intervalX\n    as: $cloudFilters\n    brush: { fillOpacity: 0.08, stroke: currentColor, strokeOpacity: 0.7 }\nxDomain: [0, 360]\nxTicks: [0, 90, 180, 270, 360]\ncolorDomain: [\"Below 2 km\", \"2–5 km\", \"5–8 km\", \"8–11 km\", \"Above 11 km\"]\ncolorRange: [\"#5b5bd6\", \"#3fa7d6\", \"#59d4a8\", \"#f2c14e\", \"#fff4d6\"]\nxLabel: Bearing (°, 0 = N, 90 = E) →\nyLabel: ↑ Voxels\nmarginLeft: 48\nmarginBottom: 36\n",
                "variables": "- param: cloudFilters\n  column: bearing_deg\n  from: b_lo\n  to: b_hi\n"
              }
            },
            "version": "2.3.1"
          }
        }
      },
