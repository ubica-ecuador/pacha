      "panel-7": {
        "kind": "Panel",
        "spec": {
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "hidden": false,
                    "query": {
                      "datasource": {
                        "name": "duckdb"
                      },
                      "group": "motherduck-duckdb-datasource",
                      "kind": "DataQuery",
                      "spec": {
                        "format": 1,
                        "rawQuery": true,
                        "rawSql": "-- La media de la figura dibujada, mes por mes, en UNA sola peticion.\n--\n-- El mismo truco que el pronostico GFS: NO fijar `month`. Con la banda fijada\n-- (`sel=band=tavg`) y el eje de meses intacto, TiTiler lo deja como bandas y\n-- devuelve una por mes, cada una con su media, su minimo y su maximo; la\n-- descripcion de cada banda es el mes (\"1.0\" ... \"12.0\").\n--\n-- Las variables como en el resto del tablero: ${store:percentencode} llega\n-- cruda (un modificador de formato apaga el entrecomillado automatico) y $zona\n-- va con `:raw`, porque el automatismo escaparia las comillas del GeoJSON.\nLOAD http_client; LOAD json;\nWITH resp AS (\n  SELECT (http_post(\n    'http://titiler/zarr/statistics?url=' || '${store:percentencode}'\n      || '\u0026variable=climate\u0026group=4\u0026sel=band%3Dtavg',\n    MAP {'content-type': 'application/json'},\n    ('{\"type\":\"Feature\",\"properties\":{},\"geometry\":' || '${zona:raw}' || '}')::JSON\n  ) -\u003e\u003e 'body')::JSON AS body\n), st AS (\n  SELECT body -\u003e 'properties' -\u003e 'statistics' AS s FROM resp\n), bandas AS (\n  SELECT s, unnest(json_keys(s)) AS b FROM st\n)\nSELECT\n  CAST(json_extract_string(s, '$.\"' || b || '\".description') AS DOUBLE)::INTEGER AS month,\n  json_extract(s, '$.\"' || b || '\".mean')::DOUBLE AS mean,\n  json_extract(s, '$.\"' || b || '\".min')::DOUBLE  AS min,\n  json_extract(s, '$.\"' || b || '\".max')::DOUBLE  AS max\nFROM bandas\nORDER BY month"
                      },
                      "version": "v0"
                    },
                    "refId": "A"
                  }
                }
              ],
              "queryOptions": {},
              "transformations": []
            }
          },
          "description": "The mean over the drawn area for each of the twelve months, in one request: leaving the month axis unpinned makes the tile server answer with one band per month. Bars are coloured with the map’s ramp. Click a bar to draw that month on the map and measure it on the right.",
          "id": 7,
          "links": [],
          "title": "Mean temperature in the area · month by month",
