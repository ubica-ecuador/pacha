{
  "apiVersion": "dashboard.grafana.app/v2",
  "kind": "Dashboard",
  "metadata": {
    "name": "esri-image"
  },
  "spec": {
    "annotations": [
      {
        "kind": "AnnotationQuery",
        "spec": {
          "builtIn": true,
          "enable": true,
          "hide": true,
          "iconColor": "rgba(0, 211, 255, 1)",
          "legacyOptions": {
            "type": "dashboard"
          },
          "name": "Annotations \u0026 Alerts",
          "query": {
            "datasource": {
              "name": "-- Grafana --"
            },
            "group": "grafana",
            "kind": "DataQuery",
            "spec": {},
            "version": "v0"
          }
        }
      }
    ],
    "cursorSync": "Off",
    "description": "The 10 m land-cover map of the whole planet that Impact Observatory, Microsoft and Esri derive from Sentinel-2, one map per year from 2017 to 2025: water, trees, crops, built area, bare ground, snow and rangeland, drawn straight from a public ArcGIS Image Service at any zoom. Pick the year above the map.",
    "editable": true,
    "elements": {
      "panel-1": {
        "kind": "Panel",
        "spec": {
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "hidden": false,
                    "query": {
                      "datasource": {
                        "name": "duckdb"
                      },
                      "group": "motherduck-duckdb-datasource",
                      "kind": "DataQuery",
                      "spec": {
                        "format": 1,
                        "rawSql": "-- Un servicio, no un fichero. No hace falta servidor de teselas propio ni\n-- firma: el ImageServer es un mosaic dataset --catalogo, regla de eleccion y\n-- piramide sobre el conjunto-- y responde para cualquier extension y zoom.\n--\n-- La regla de mosaico es la que elige el ano.\nSELECT\n  'https://ic.imagery1.arcgis.com/arcgis/rest/services/Sentinel2_10m_LandCover/ImageServer' AS esri_url,\n  '{\"mosaicMethod\":\"esriMosaicAttribute\",\"where\":\"Year=' || CAST($anio AS VARCHAR) || '\"}' AS mosaic_rule\n"
                      },
                      "version": "v0"
                    },
                    "refId": "A"
                  }
                }
              ],
              "queryOptions": {},
              "transformations": []
            }
          },
          "description": "Nine classes at 10 m: water (blue), trees (dark green), flooded vegetation, crops (yellow), built area (red), bare ground (pale beige), snow and ice (white), clouds and rangeland (tan). The ImageServer renders them at whatever extent and zoom the map asks for; change the year above the map.",
          "id": 1,
          "links": [],
          "title": "Land cover in $anio · Sentinel-2, 10 m",
          "vizConfig": {
            "group": "ubica-keplergl-panel",
            "kind": "VizConfig",
            "spec": {
              "fieldConfig": {
                "defaults": {},
                "overrides": []
              },
              "options": {
                "followGrafanaTheme": true,
                "mapConfig": {
                  "config": {
                    "mapState": {
                      "bearing": 0,
                      "dragRotate": false,
                      "latitude": 5,
                      "longitude": -30,
                      "pitch": 0,
                      "zoom": 2
                    },
                    "visState": {
                      "filters": [],
                      "interactionConfig": {
                        "brush": {
                          "enabled": false,
                          "size": 0.5
                        },
                        "coordinate": {
                          "enabled": false
                        },
                        "geocoder": {
                          "enabled": false
                        },
                        "tooltip": {
                          "enabled": false
                        }
                      },
                      "layerBlending": "normal",
                      "layerOrder": [],
                      "layers": []
                    }
                  },
                  "datasets": [],
                  "version": "v1"
                },
                "showSidePanel": false,
                "timeSync": "off"
              }
            },
            "version": ""
          }
        }
      }
    },
    "layout": {
      "kind": "GridLayout",
      "spec": {
        "items": [
          {
            "kind": "GridLayoutItem",
            "spec": {
              "element": {
                "kind": "ElementReference",
                "name": "panel-1"
              },
              "height": 20,
              "width": 24,
              "x": 0,
              "y": 0
            }
          }
        ]
      }
    },
    "links": [],
    "liveNow": false,
    "preload": false,
    "tags": [
      "duckdb",
      "kepler",
      "satellite"
    ],
    "timeSettings": {
      "autoRefresh": "",
      "autoRefreshIntervals": [
        "5s",
        "10s",
        "30s",
        "1m",
        "5m",
        "15m",
        "30m",
        "1h",
        "2h",
        "1d"
      ],
      "fiscalYearStartMonth": 0,
      "from": "now-6h",
      "hideTimepicker": false,
      "timezone": "browser",
      "to": "now"
    },
    "title": "Land cover of the world — Sentinel-2 10 m, year by year",
    "variables": [
      {
        "kind": "CustomVariable",
        "spec": {
          "allowCustomValue": true,
          "current": {
            "text": "2025",
            "value": "2025"
          },
          "hide": "dontHide",
          "includeAll": false,
          "label": "Year",
          "multi": false,
          "name": "anio",
          "options": [],
          "query": "2017, 2018, 2019, 2020, 2021, 2022, 2023, 2024, 2025",
          "skipUrlSync": false
        }
      }
    ]
  }
}