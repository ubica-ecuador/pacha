      "panel-7": {
        "kind": "Panel",
        "spec": {
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "hidden": false,
                    "query": {
                      "datasource": {
                        "name": "duckdb"
                      },
                      "group": "motherduck-duckdb-datasource",
                      "kind": "DataQuery",
                      "spec": {
                        "format": 1,
                        "rawQuery": true,
                        "rawSql": "-- Airline flights only: three letters, then the flight number.\nSELECT left(flight, 3) AS \"Airline\", count(DISTINCT hex) AS \"Aircraft\", count(DISTINCT flight) AS \"Flights\"\nFROM read_parquet([${files:singlequote}])\nWHERE ts BETWEEN $__timeFrom() AND $__timeTo() AND regexp_matches(flight, '^[A-Z]{3}[0-9]')\nGROUP BY 1\nORDER BY 2 DESC\nLIMIT 25"
                      },
                      "version": "v0"
                    },
                    "refId": "A"
                  }
                }
              ],
              "queryOptions": {},
              "transformations": []
            }
          },
          "description": "The ICAO airline prefix of the callsign, by distinct aircraft heard over the range.",
          "id": 7,
          "links": [],
          "title": "Airlines",
          "vizConfig": {
            "group": "table",
            "kind": "VizConfig",
            "spec": {
              "fieldConfig": {
