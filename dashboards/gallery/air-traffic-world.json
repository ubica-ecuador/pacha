                              },
                              "coverage": 1,
                              "enable3d": false,
                              "opacity": 0.8
                            }
                          },
                          "id": "density",
                          "type": "hexagonId",
                          "visualChannels": {
                            "colorField": {
                              "name": "aircraft",
                              "type": "integer"
                            },
                            "colorScale": "quantile"
                          }
                        }
                      ],
                      "splitMaps": []
                    }
                  },
                  "version": "v1"
                },
                "peerTimeSync": false,
                "publishIntervalMs": 1500,
                "publishWhilePlaying": false,
                "rasterBands": "",
                "rasterColormap": "",
                "rasterPainted": false,
                "showSidePanel": false,
                "timeSync": "off",
                "tripLayerMode": "table",
                "variableMappings": []
              }
            },
            "version": "1.1.0"
          }
        }
      },
      "panel-5": {
        "kind": "Panel",
        "spec": {
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "hidden": false,
                    "query": {
                      "datasource": {
                        "name": "duckdb"
                      },
                      "group": "motherduck-duckdb-datasource",
                      "kind": "DataQuery",
                      "spec": {
                        "format": 1,
                        "rawQuery": true,
                        "rawSql": "-- A trip id, a time and a position: the panel builds an animated Trip layer.\nWITH area AS (\n  SELECT list_transform(xs, lambda x: x - 360 * round(coalesce(list_avg(xs), 0) / 360)) AS xs, ys\n  FROM (\n    SELECT\n      list_filter(n, lambda v, i: i % 2 = 1) AS xs,\n      list_filter(n, lambda v, i: i % 2 = 0) AS ys\n    FROM (SELECT CAST(regexp_extract_all(${area:sqlstring}, '-?[0-9]+(?:\\.[0-9]+)?(?:[eE][-+]?[0-9]+)?') AS DOUBLE[]) AS n)\n  )\n),\npts AS (\n  SELECT hex AS trip_id, flight, ts AS time, lat AS latitude, lon AS longitude,\n         alt_baro AS altitude_ft, gs AS speed_kt\n  FROM read_parquet([${files:singlequote}])\n  WHERE ts BETWEEN $__timeFrom() AND $__timeTo()\n)\nSELECT pts.* FROM pts, area\nWHERE CASE WHEN ${hex:sqlstring} \u003c\u003e '' THEN trip_id = ${hex:sqlstring}\n           ELSE len(area.xs) \u003e 0 AND (len(area.xs) = 0 OR list_sum(list_transform(range(1, len(area.xs) + 1), lambda i:\n  CASE WHEN (area.ys[i] \u003e latitude) \u003c\u003e (area.ys[i % len(area.xs) + 1] \u003e latitude)\n        AND longitude \u003c (area.xs[i % len(area.xs) + 1] - area.xs[i]) * (latitude - area.ys[i]) / (area.ys[i % len(area.xs) + 1] - area.ys[i]) + area.xs[i]\n       THEN 1 ELSE 0 END)) % 2 = 1) END\nORDER BY trip_id, time\nLIMIT 50000"
                      },
                      "version": "v0"
                    },
                    "refId": "A"
                  }
                }
              ],
              "queryOptions": {},
              "transformations": []
            }
          },
          "description": "The recorded track of the aircraft picked on the live map (or typed above), replayed over the time range. With none picked, draw an area here to replay every aircraft inside it, up to 50,000 positions.",
          "id": 5,
          "links": [],
          "title": "Tracks: the picked aircraft, or the drawn area",
          "vizConfig": {
            "group": "ubica-keplergl-panel",
            "kind": "VizConfig",
            "spec": {
              "fieldConfig": {
                "defaults": {},
                "overrides": []
              },
              "options": {
                "areaVariable": "area",
                "basemap": "dark-matter",
                "clickArea": false,
                "clickAreaSizeMetres": 6000,
                "clickConfirm": false,
                "flowRenderMode": "straight",
                "followGrafanaTheme": true,
                "hoverMaxAgeSeconds": 60,
                "hoverPublishSpike": false,
                "hoverSync": false,
                "mapConfig": {
                  "config": {
                    "mapState": {
                      "bearing": 0,
                      "dragRotate": false,
                      "latitude": 30,
                      "longitude": 0,
                      "pitch": 0,
                      "zoom": 1.3
                    },
                    "mapStyle": {
                      "styleType": "dark-matter"
                    },
                    "visState": {
                      "animationConfig": {
                        "speed": 1
                      },
                      "filters": [],
                      "interactionConfig": {
                        "brush": {
                          "enabled": false,
                          "size": 0.5
                        },
                        "coordinate": {
                          "enabled": false
                        },
                        "geocoder": {
                          "enabled": false
                        },
                        "tooltip": {
                          "config": {
                            "compareMode": false,
                            "compareType": "absolute",
                            "fieldsToShow": {
                              "grafana-A": [
                                {
                                  "name": "flight"
                                },
                                {
                                  "name": "altitude_ft"
                                },
                                {
                                  "name": "speed_kt"
                                }
                              ]
                            }
                          },
                          "enabled": true
                        }
                      },
                      "layerBlending": "normal",
                      "splitMaps": []
                    }
                  },
                  "version": "v1"
                },
                "peerTimeSync": false,
                "publishIntervalMs": 1500,
                "publishWhilePlaying": false,
                "rasterBands": "",
                "rasterColormap": "",
                "rasterPainted": false,
                "showSidePanel": false,
                "timeSync": "off",
                "tripLayerMode": "table",
                "variableMappings": [
                  {
                    "field": "trip_id",
                    "source": "click",
                    "variable": "hex"
                  }
                ]
              }
            },
            "version": "1.1.0"
          }
        }
      },
      "panel-6": {
        "kind": "Panel",
        "spec": {
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "hidden": false,
                    "query": {
                      "datasource": {
                        "name": "duckdb"
                      },
                      "group": "motherduck-duckdb-datasource",
                      "kind": "DataQuery",
                      "spec": {
                        "format": 1,
                        "rawQuery": true,
                        "rawSql": "-- One bar a minute at least, wider as the range grows.\nSELECT time_bucket(to_milliseconds(greatest($__interval_ms, 60000)), ts) AS time,\n       count(DISTINCT hex) AS \"Aircraft heard\"\nFROM read_parquet([${files:singlequote}])\nWHERE ts BETWEEN $__timeFrom() AND $__timeTo()\nGROUP BY 1\nORDER BY 1"
                      },
                      "version": "v0"
                    },
                    "refId": "A"
                  }
                }
              ],
              "queryOptions": {},
              "transformations": []
            }
          },
          "description": "Distinct aircraft heard in each interval. A missing bar is a gap in the recording, not empty skies.",
          "id": 6,
          "links": [],
          "title": "Aircraft heard",
          "vizConfig": {
            "group": "timeseries",
            "kind": "VizConfig",
            "spec": {
