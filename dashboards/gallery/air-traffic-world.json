{
  "apiVersion": "dashboard.grafana.app/v2",
  "kind": "Dashboard",
  "metadata": {
    "name": "air-traffic-world"
  },
  "spec": {
    "annotations": [
      {
        "kind": "AnnotationQuery",
        "spec": {
          "builtIn": true,
          "enable": true,
          "hide": true,
          "iconColor": "rgba(0, 211, 255, 1)",
          "legacyOptions": {
            "type": "dashboard"
          },
          "name": "Annotations \u0026 Alerts",
          "query": {
            "datasource": {
              "name": "-- Grafana --"
            },
            "group": "grafana",
            "kind": "DataQuery",
            "spec": {},
            "version": "v0"
          }
        }
      }
    ],
    "cursorSync": "Crosshair",
    "description": "Every aircraft adsb.lol's volunteer receivers hear, live, and the last week of their positions as this instance recorded them. Coverage is dense over Europe and North America and thin elsewhere. The history needs the recorder (compose profile `recorder`). Data: adsb.lol, ODbL.",
    "editable": true,
    "elements": {
      "panel-1": {
        "kind": "Panel",
        "spec": {
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "hidden": false,
                    "query": {
                      "datasource": {
                        "name": "duckdb"
                      },
                      "group": "motherduck-duckdb-datasource",
                      "kind": "DataQuery",
                      "spec": {
                        "format": 1,
                        "rawQuery": true,
                        "rawSql": "-- The live snapshot through the gateway, which asks adsb.lol once a minute.\nWITH a AS (SELECT unnest(ac) AS a FROM read_json('http://feeds/adsblol/world', columns = {ac: 'JSON[]'}))\nSELECT count(*) FILTER (WHERE a-\u003e\u003e'lat' IS NOT NULL) AS \"Aircraft\",\n       count(*) FILTER (WHERE a-\u003e\u003e'alt_baro' = 'ground') AS \"On the ground\",\n       count(*) FILTER (WHERE a-\u003e\u003e'squawk' IN ('7500', '7600', '7700')) AS \"Emergency squawks\"\nFROM a"
                      },
                      "version": "v0"
                    },
                    "refId": "A"
                  }
                }
              ],
              "queryOptions": {},
              "transformations": []
            }
          },
          "description": "Every aircraft adsb.lol hears right now, worldwide.",
          "id": 1,
          "links": [],
          "title": "In the air now",
          "vizConfig": {
            "group": "stat",
            "kind": "VizConfig",
            "spec": {
              "fieldConfig": {
                "defaults": {
                  "decimals": 0,
                  "unit": "short"
                },
                "overrides": []
              },
              "options": {
                "colorMode": "none",
                "graphMode": "none",
                "justifyMode": "auto",
                "orientation": "auto",
                "percentChangeColorMode": "standard",
                "reduceOptions": {
                  "calcs": [
                    "lastNotNull"
                  ],
                  "fields": "/.*/",
                  "values": false
                },
                "showPercentChange": false,
                "textMode": "value_and_name",
                "wideLayout": true
              }
            },
            "version": "13.2.1"
          }
        }
      },
      "panel-2": {
        "kind": "Panel",
        "spec": {
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "hidden": false,
                    "query": {
                      "datasource": {
                        "name": "duckdb"
                      },
                      "group": "motherduck-duckdb-datasource",
                      "kind": "DataQuery",
                      "spec": {
                        "format": 1,
                        "rawQuery": true,
                        "rawSql": "SELECT count(DISTINCT hex) AS \"Aircraft heard\", count(*) AS \"Positions\"\nFROM read_parquet([${files:singlequote}])\nWHERE ts BETWEEN $__timeFrom() AND $__timeTo()"
                      },
                      "version": "v0"
                    },
                    "refId": "A"
                  }
                }
              ],
              "queryOptions": {},
              "transformations": []
            }
          },
          "description": "What this instance recorded over the dashboard's time range. Empty without the recorder (compose profile `recorder`).",
          "id": 2,
          "links": [],
          "title": "Recorded in this range",
          "vizConfig": {
            "group": "stat",
            "kind": "VizConfig",
            "spec": {
              "fieldConfig": {
                "defaults": {
                  "decimals": 0,
                  "unit": "short"
                },
                "overrides": []
              },
              "options": {
                "colorMode": "none",
                "graphMode": "none",
                "justifyMode": "auto",
                "orientation": "auto",
                "percentChangeColorMode": "standard",
                "reduceOptions": {
                  "calcs": [
                    "lastNotNull"
                  ],
                  "fields": "/.*/",
                  "values": false
                },
                "showPercentChange": false,
                "textMode": "value_and_name",
                "wideLayout": true
              }
            },
            "version": "13.2.1"
          }
        }
      },
      "panel-3": {
        "kind": "Panel",
        "spec": {
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "hidden": false,
                    "query": {
                      "datasource": {
                        "name": "duckdb"
                      },
                      "group": "motherduck-duckdb-datasource",
                      "kind": "DataQuery",
                      "spec": {
                        "format": 1,
                        "rawQuery": true,
                        "rawSql": "-- One row per aircraft with a position. `track` (degrees) points it; altitude is\n-- 0 on the ground.\nWITH a AS (SELECT unnest(ac) AS a FROM read_json('http://feeds/adsblol/world', columns = {ac: 'JSON[]'}))\nSELECT a-\u003e\u003e'hex' AS hex, nullif(trim(a-\u003e\u003e'flight'), '') AS flight, a-\u003e\u003e't' AS type, a-\u003e\u003e'r' AS reg,\n       (a-\u003e\u003e'lat')::DOUBLE AS latitude, (a-\u003e\u003e'lon')::DOUBLE AS longitude,\n       coalesce(try_cast(a-\u003e\u003e'alt_baro' AS INTEGER), 0) AS altitude_ft,\n       (a-\u003e\u003e'gs')::DOUBLE AS speed_kt, (a-\u003e\u003e'track')::DOUBLE AS track, a-\u003e\u003e'squawk' AS squawk\nFROM a\nWHERE a-\u003e\u003e'lat' IS NOT NULL"
                      },
                      "version": "v0"
                    },
                    "refId": "A"
                  }
                }
              ],
              "queryOptions": {},
              "transformations": []
            }
          },
          "description": "adsb.lol's receivers, refreshed every minute: coloured by altitude, pointing where each aircraft is going. Coverage is dense over Europe and North America and thin elsewhere. Click an aircraft to follow it in the history below.",
          "id": 3,
          "links": [],
          "title": "Live: every aircraft in the world",
          "vizConfig": {
            "group": "ubica-keplergl-panel",
            "kind": "VizConfig",
            "spec": {
              "fieldConfig": {
                "defaults": {},
                "overrides": []
              },
              "options": {
                "basemap": "dark-matter",
                "clickArea": false,
                "clickAreaSizeMetres": 6000,
                "clickConfirm": false,
                "flowRenderMode": "straight",
                "followGrafanaTheme": true,
                "hoverMaxAgeSeconds": 60,
                "hoverPublishSpike": false,
                "hoverSync": false,
                "mapConfig": {
                  "config": {
                    "mapState": {
                      "bearing": 0,
                      "dragRotate": false,
                      "latitude": 30,
                      "longitude": 0,
                      "pitch": 0,
                      "zoom": 1.6
                    },
                    "mapStyle": {
                      "styleType": "dark-matter"
                    },
                    "visState": {
                      "animationConfig": {
                        "speed": 1
                      },
                      "filters": [],
                      "interactionConfig": {
                        "brush": {
                          "enabled": false,
                          "size": 0.5
                        },
                        "coordinate": {
                          "enabled": false
                        },
                        "geocoder": {
                          "enabled": false
                        },
                        "tooltip": {
                          "config": {
                            "compareMode": false,
                            "compareType": "absolute",
                            "fieldsToShow": {
                              "grafana-A": [
                                {
                                  "name": "flight"
                                },
                                {
                                  "name": "type"
                                },
                                {
                                  "name": "reg"
                                },
                                {
                                  "name": "altitude_ft"
                                },
                                {
                                  "name": "speed_kt"
                                },
                                {
                                  "name": "squawk"
                                }
                              ]
                            }
                          },
                          "enabled": true
                        }
                      },
                      "layerBlending": "normal",
                      "splitMaps": []
                    }
                  },
                  "version": "v1"
                },
                "peerTimeSync": false,
                "publishIntervalMs": 1500,
                "publishWhilePlaying": false,
                "rasterBands": "",
                "rasterColormap": "",
                "rasterPainted": false,
                "showSidePanel": false,
                "timeSync": "off",
                "tripLayerMode": "table",
                "variableMappings": [
                  {
                    "field": "hex",
                    "source": "click",
                    "variable": "hex"
                  }
                ]
              }
            },
            "version": "1.1.0"
          }
        }
      },
      "panel-4": {
        "kind": "Panel",
        "spec": {
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "hidden": false,
                    "query": {
                      "datasource": {
                        "name": "duckdb"
                      },
                      "group": "motherduck-duckdb-datasource",
                      "kind": "DataQuery",
                      "spec": {
                        "format": 1,
                        "rawQuery": true,
                        "rawSql": "-- H3 resolution 4 (about 1,800 km2) up to a day, 3 beyond it.\nSELECT h3_h3_to_string(h3_cell_to_parent(cell, CASE WHEN $__timeTo()::TIMESTAMPTZ - $__timeFrom()::TIMESTAMPTZ \u003e INTERVAL 1 DAY THEN 3 ELSE 4 END)) AS h3,\n       count(DISTINCT hex) AS aircraft, count(*) AS positions\nFROM read_parquet([${files:singlequote}])\nWHERE ts BETWEEN $__timeFrom() AND $__timeTo()\nGROUP BY 1"
                      },
                      "version": "v0"
                    },
                    "refId": "A"
                  }
                }
              ],
              "queryOptions": {},
              "transformations": []
            }
          },
          "description": "Distinct aircraft heard in each H3 cell over the time range, from this instance's recording. Cells are coarser for ranges over a day.",
          "id": 4,
          "links": [],
          "title": "Where aircraft flew",
          "vizConfig": {
            "group": "ubica-keplergl-panel",
            "kind": "VizConfig",
            "spec": {
              "fieldConfig": {
                "defaults": {},
                "overrides": []
              },
              "options": {
                "basemap": "dark-matter",
                "clickArea": false,
                "clickAreaSizeMetres": 6000,
                "clickConfirm": false,
                "flowRenderMode": "straight",
                "followGrafanaTheme": true,
                "hoverMaxAgeSeconds": 60,
                "hoverPublishSpike": false,
                "hoverSync": false,
                "mapConfig": {
                  "config": {
                    "mapState": {
                      "bearing": 0,
                      "dragRotate": false,
                      "latitude": 30,
                      "longitude": 0,
                      "pitch": 0,
                      "zoom": 1.3
                    },
                    "mapStyle": {
                      "styleType": "dark-matter"
                    },
                    "visState": {
                      "animationConfig": {
                        "speed": 1
                      },
                      "filters": [],
                      "interactionConfig": {
                        "brush": {
                          "enabled": false,
                          "size": 0.5
                        },
                        "coordinate": {
                          "enabled": false
                        },
                        "geocoder": {
                          "enabled": false
                        },
                        "tooltip": {
                          "config": {
                            "compareMode": false,
                            "compareType": "absolute",
                            "fieldsToShow": {
                              "grafana-A": [
                                {
                                  "name": "aircraft"
                                },
                                {
                                  "name": "positions"
                                }
                              ]
                            }
                          },
                          "enabled": true
                        }
                      },
                      "layerBlending": "normal",
                      "layerOrder": [
                        "density"
                      ],
                      "layers": [
                        {
                          "config": {
                            "color": [
                              255,
                              203,
                              153
                            ],
                            "columns": {
                              "hex_id": "h3"
                            },
                            "dataId": "grafana-A",
                            "isVisible": true,
                            "label": "Aircraft heard",
                            "visConfig": {
                              "colorRange": {
                                "category": "Uber",
                                "colors": [
                                  "#5A1846",
                                  "#900C3F",
                                  "#C70039",
                                  "#E3611C",
                                  "#F1920E",
                                  "#FFC300"
                                ],
                                "name": "Global Warming",
