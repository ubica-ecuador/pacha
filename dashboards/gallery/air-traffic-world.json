      "panel-8": {
        "kind": "Panel",
        "spec": {
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "hidden": false,
                    "query": {
                      "datasource": {
                        "name": "duckdb"
                      },
                      "group": "motherduck-duckdb-datasource",
                      "kind": "DataQuery",
                      "spec": {
                        "format": 1,
                        "rawQuery": true,
                        "rawSql": "SELECT type AS \"Type\", count(DISTINCT hex) AS \"Aircraft\"\nFROM read_parquet([${files:singlequote}])\nWHERE ts BETWEEN $__timeFrom() AND $__timeTo() AND type IS NOT NULL\nGROUP BY 1\nORDER BY 2 DESC\nLIMIT 25"
                      },
                      "version": "v0"
                    },
                    "refId": "A"
                  }
                }
              ],
              "queryOptions": {},
              "transformations": []
            }
          },
          "description": "ICAO type designators, by distinct aircraft heard over the range.",
          "id": 8,
