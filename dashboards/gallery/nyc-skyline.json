      "panel-3": {
        "kind": "Panel",
        "spec": {
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "hidden": false,
                    "query": {
                      "datasource": {
                        "name": "duckdb"
                      },
                      "group": "motherduck-duckdb-datasource",
                      "kind": "DataQuery",
                      "spec": {
                        "format": 1,
                        "rawSql": "WITH b AS (\n  SELECT bin, height_roof,\n         ST_Transform(ST_Centroid(geometry), 'EPSG:4326', 'EPSG:32618', always_xy := true) AS pt,\n         ST_Area(ST_Transform(geometry, 'EPSG:4326', 'EPSG:32618', always_xy := true)) AS footprint_m2\n  FROM read_parquet('http://feeds/geolens/datasets/4a0bd0db-cd92-424a-8a2e-62d270ae918a.parquet')\n  WHERE height_roof \u003e= CAST($minHeight AS DOUBLE)\n    AND era IN (${era:singlequote})\n), s AS (\n  SELECT stop_name, daytime_routes, borough, ada,\n         ST_Transform(geometry, 'EPSG:4326', 'EPSG:32618', always_xy := true) AS pt\n  FROM read_parquet('http://feeds/geolens/datasets/c646ff35-82eb-442f-a524-efcbb1645023.parquet')\n)\n, tagged AS (\n  SELECT EXISTS (\n    SELECT 1 FROM s WHERE ST_DWithin(b.pt, s.pt, CAST($radius AS DOUBLE))\n  ) AS served\n  FROM b\n)\nSELECT\n  round(100.0 * count(*) FILTER (WHERE served) / nullif(count(*), 0), 1) AS \"Within reach\",\n  count(*) FILTER (WHERE served) AS \"Buildings served\",\n  count(*) AS \"Buildings shown\"\nFROM tagged"
                      },
                      "version": "v0"
                    },
                    "refId": "A"
                  }
                }
              ],
              "queryOptions": {},
              "transformations": []
            }
          },
          "id": 3,
          "links": [],
          "title": "Within ${radius:text} of a station",
