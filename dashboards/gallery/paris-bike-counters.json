    "title": "Paris by bike — every counter, hour by hour",
    "variables": [
      {
        "kind": "QueryVariable",
        "spec": {
          "allowCustomValue": true,
          "current": {
            "text": "",
            "value": ""
          },
          "hide": "hideVariable",
          "includeAll": false,
          "multi": false,
          "name": "bikes",
          "options": [],
          "query": {
            "datasource": {
              "name": "duckdbwasm"
            },
            "group": "ubica-chaski-datasource",
            "kind": "DataQuery",
            "spec": {
              "kind": "dataset",
              "name": "bikes",
              "refId": "bikes",
              "source": {
                "datasource": {
                  "type": "motherduck-duckdb-datasource",
                  "uid": "duckdb"
                },
                "query": {
                  "datasource": {
                    "type": "motherduck-duckdb-datasource",
                    "uid": "duckdb"
                  },
                  "editorMode": "code",
                  "format": 1,
                  "rawQuery": true,
                  "rawSql": "-- Server side: the City of Paris's bike counters (Eco-Counter loops in the cycle lanes, one\n-- per direction of travel) over the last 28 days, hour by hour, from Paris Data, which\n-- publishes each day up to the evening before. Each counter is put in its arrondissement\n-- (the City's own outlines, with spatial on the server) and its hours on the Paris clock,\n-- the time a rush hour keeps all year.\n--\n-- lane is the counter's row in the heatmap: arrondissement by arrondissement, the busiest\n-- first, with an empty lane between two arrondissements so the groups read apart.\n-- peak is the counter's busiest hour of the 28 days and share each hour over it: the\n-- heatmap divides by the larger of peak and a soft maximum it lets you choose.\nSET VARIABLE since = strftime(current_date - 28, '%Y-%m-%d');\nSET VARIABLE counts_url = 'https://opendata.paris.fr/api/explore/v2.1/catalog/datasets/comptage-velo-donnees-compteurs/exports/parquet'\n  || '?select=id_compteur,nom_compteur,date,sum_counts,coordinates'\n  || '\u0026where=date%3E%3D%27' || getvariable('since') || '%27';\nLOAD spatial;\nWITH arrondissements AS (\n  SELECT c_ar AS arr_no, geom\n  FROM read_parquet('https://opendata.paris.fr/api/explore/v2.1/catalog/datasets/arrondissements/exports/parquet?select=c_ar,geom')\n), counts AS (\n  SELECT id_compteur AS counter, nom_compteur AS name, coordinates AS geom,\n         date AS time_utc,\n         (date AT TIME ZONE 'Europe/Paris') AS time,\n         sum_counts AS bikes\n  FROM read_parquet(getvariable('counts_url'))\n  WHERE sum_counts IS NOT NULL\n), counters AS (\n  SELECT c.counter, any_value(c.name) AS name,\n         any_value(ST_Y(c.geom)) AS latitude, any_value(ST_X(c.geom)) AS longitude,\n         coalesce(any_value(a.arr_no), 21) AS arr_no,\n         max(c.bikes) AS peak, sum(c.bikes) AS total\n  FROM counts c LEFT JOIN arrondissements a ON ST_Within(c.geom, a.geom)\n  GROUP BY c.counter\n), lanes AS (\n  SELECT *,\n         CASE WHEN arr_no = 21 THEN 'Outside Paris'\n              WHEN arr_no = 1 THEN '1er' ELSE arr_no || 'e' END AS arrondissement,\n         row_number() OVER (ORDER BY arr_no, total DESC, counter) + dense_rank() OVER (ORDER BY arr_no) - 1 AS lane\n  FROM counters\n)\nSELECT l.counter, l.name, l.arrondissement, l.arr_no::DOUBLE AS arr_no, l.lane::DOUBLE AS lane,\n       l.latitude, l.longitude,\n       h.time,\n       hour(h.time)::DOUBLE AS hour,\n       CASE WHEN isodow(h.time) \u003e= 6 THEN 'Weekend' ELSE 'Weekday' END AS day_type,\n       h.bikes::DOUBLE AS bikes,\n       l.peak::DOUBLE AS peak,\n       round(h.bikes / greatest(l.peak, 1), 3) AS share,\n       h.latest\nFROM (SELECT counter, time, sum(bikes) AS bikes, max(time_utc) AS latest FROM counts GROUP BY ALL) h\nJOIN lanes l USING (counter)\nORDER BY h.time, l.lane",
                  "refId": "bikes"
                },
                "type": "datasource"
              }
            },
            "version": "v0"
          },
