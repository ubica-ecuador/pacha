      "panel-profile": {
        "kind": "Panel",
        "spec": {
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [],
              "queryOptions": {},
              "transformations": []
            }
          },
          "description": "Bikes an hour past all the counters the filters leave, on an average weekday and an average weekend day: the two rush hours of commuting against one long afternoon.",
          "id": 9,
          "links": [],
          "title": "An average day, weekdays and weekends",
          "vizConfig": {
            "group": "ubica-chaski-mosaic-panel",
            "kind": "VizConfig",
            "spec": {
              "fieldConfig": {
                "defaults": {},
                "overrides": []
              },
              "options": {
                "preaggregate": true,
                "reads": "",
                "spec": "params:\n  bikeFilters: { select: crossfilter }\nvconcat:\n  - legend: color\n    for: profile\n  - name: profile\n    plot:\n      - mark: lineY\n        data: { from: bikes, filterBy: $bikeFilters }\n        x: hour\n        y: { sql: \"sum(bikes) / count(DISTINCT time::DATE)\" }\n        stroke: day_type\n        strokeWidth: 2\n        curve: monotone-x\n    colorDomain: [Weekday, Weekend]\n    colorRange: ['#5794F2', '#FF9830']\n    xDomain: [0, 23]\n    xTicks: 12\n    xLabel: Hour of the day (Paris) →\n    yLabel: ↑ Bikes an hour, all counters\n    yTickFormat: s\n",
                "variables": ""
              }
            }
          }
        }
      },
      "panel-read": {
        "kind": "Panel",
        "spec": {
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [],
