      "panel-heatmap": {
        "kind": "Panel",
        "spec": {
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [],
              "queryOptions": {},
              "transformations": []
            }
          },
          "description": "One row per counter (a direction of travel), grouped by arrondissement with a gap between two, busiest first; one column per hour, Paris time. The colour is each hour over the larger of the counter’s busiest hour of the 28 days and the soft max: at 0 every counter is on its own scale and a quiet street’s rush hour looks like Sébastopol’s; raise it and the quiet counters fade, until past the busiest hour of all (about 1,600) every counter is on the same scale. Empty cells are hours with no data, not zero. Drag across the hours to filter the rest of the dashboard.",
          "id": 6,
          "links": [],
          "title": "Every counter, hour by hour",
          "vizConfig": {
            "group": "ubica-chaski-mosaic-panel",
            "kind": "VizConfig",
            "spec": {
              "fieldConfig": {
                "defaults": {},
                "overrides": []
              },
              "options": {
                "preaggregate": true,
                "reads": "",
                "spec": "params:\n  bikeFilters: { select: crossfilter }\n  softmax: 150\nvconcat:\n  - input: slider\n    label: Soft max (bikes an hour)\n    as: $softmax\n    min: 0\n    max: 1700\n    step: 10\n  - legend: color\n    for: grid\n    label: The hour over the larger of the counter's busiest hour and the soft max\n  - name: grid\n    plot:\n      - mark: raster\n        data: { from: bikes, filterBy: $bikeFilters }\n        x: time\n        y: lane\n        fill: { sql: \"max(bikes / greatest(peak, $softmax))\" }\n        fillOpacity: { count: }\n        width: 670\n        height: 126\n        pad: 0.99\n        imageRendering: pixelated\n      - mark: text\n        data: { from: bikes }\n        x: { min: time }\n        y: { min: lane }\n        text: arrondissement\n        textAnchor: end\n        lineAnchor: top\n        dx: -6\n        dy: -3\n        fill: currentColor\n        fontSize: 10\n      - mark: ruleY\n        data: { from: bikes }\n        y: lane\n        title: name\n        strokeOpacity: 0\n        tip: { pointer: y }\n      - select: intervalX\n        as: $bikeFilters\n        field: time\n    colorScheme: viridis\n    colorDomain: [0, 1]\n    opacityDomain: [0, 1]\n    opacityClamp: true\n    xDomain: Fixed\n    yDomain: [1, 126]\n    yReverse: true\n    yAxis: null\n    xLabel: null\n    xTickFormat: '%a %d'\n    marginLeft: 84\n    marginRight: 4\n    marginTop: 6\n    marginBottom: 24\n",
                "variables": ""
              }
            }
          }
        }
      },
