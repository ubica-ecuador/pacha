            }
          },
          "description": "Bikes past the counters the filters leave, in both directions: a bike passing two counters is counted twice.",
          "id": 1,
          "links": [],
          "title": "Bikes counted",
          "vizConfig": {
            "group": "ubica-chaski-mosaic-panel",
            "kind": "VizConfig",
            "spec": {
              "fieldConfig": {
                "defaults": {},
                "overrides": []
