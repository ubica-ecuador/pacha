                "preaggregate": true,
                "reads": "",
                "spec": "params:\n  bikeFilters: { select: crossfilter }\nplot:\n  - mark: text\n    data: { from: bikes, filterBy: $bikeFilters }\n    text: { sql: \"format('{:,}', sum(bikes)::BIGINT)\" }\n    frameAnchor: middle\n    fill: '#5794F2'\n    fontSize: 40\n    fontWeight: 500\nxAxis: null\nyAxis: null\nmargin: 0\ncolorScale: identity\n",
                "variables": ""
