            "text": "",
            "value": ""
          },
          "hide": "hideVariable",
          "includeAll": false,
          "label": "Métro stations",
          "multi": false,
          "name": "stations",
          "options": [],
          "query": {
            "datasource": {
              "name": "duckdbwasm"
            },
            "group": "ubica-chaski-datasource",
            "kind": "DataQuery",
            "spec": {
              "kind": "dataset",
              "name": "stations",
              "refId": "stations",
              "source": {
                "datasource": {
                  "type": "motherduck-duckdb-datasource",
                  "uid": "duckdb"
                },
                "query": {
                  "datasource": {
                    "type": "motherduck-duckdb-datasource",
                    "uid": "duckdb"
                  },
                  "editorMode": "code",
                  "format": 1,
                  "rawQuery": true,
                  "rawSql": "-- Server side, once per visit: every Métro station, one row per line it serves,\n-- with the day it opened (date_mise), from Île-de-France Mobilités' stations of\n-- the rail network, through the gateway (http://feeds/idfm/...).\nSELECT date_mise::TIMESTAMP AS time,\n       nom_gares AS station,\n       'Line ' || indice_lig AS line,\n       year(date_mise) AS opened_in,\n       ST_Y(geo_point_2d::GEOMETRY) AS latitude,\n       ST_X(geo_point_2d::GEOMETRY) AS longitude\nFROM read_parquet('http://feeds/idfm/emplacement-des-gares-idf.parquet')\nWHERE mode = 'METRO' AND date_mise \u003c= now()\nORDER BY time",
                  "refId": "stations"
                },
                "type": "datasource"
              }
            },
            "version": "v0"
          },
          "refresh": "onDashboardLoad",
          "regex": "",
          "regexApplyTo": "value",
          "skipUrlSync": false,
          "sort": "disabled"
        }
      },
