      {
        "kind": "QueryVariable",
        "spec": {
          "allowCustomValue": true,
          "current": {
            "text": "",
            "value": ""
          },
          "hide": "hideVariable",
          "includeAll": false,
          "label": "Métro track segments",
          "multi": false,
          "name": "segments",
          "options": [],
          "query": {
            "datasource": {
              "name": "duckdbwasm"
            },
            "group": "ubica-chaski-datasource",
            "kind": "DataQuery",
            "spec": {
              "kind": "dataset",
              "name": "segments",
              "refId": "segments",
              "source": {
                "datasource": {
                  "type": "motherduck-duckdb-datasource",
                  "uid": "duckdb"
                },
                "query": {
                  "datasource": {
                    "type": "motherduck-duckdb-datasource",
                    "uid": "duckdb"
                  },
                  "editorMode": "code",
                  "format": 1,
                  "rawQuery": true,
                  "rawSql": "-- Server side, once per visit: the Paris Métro segment by segment, with the day\n-- each one opened (date_mes), its line's official colour and its length on the\n-- ellipsoid, from Île-de-France Mobilités' tracks of the rail network, through\n-- the gateway (http://feeds/idfm/...), which keeps each export a day.\n--\n-- The six segments of line 11's 2024 extension carry no date: they take the\n-- last opening among the line's stations (13 June 2024). Lines not open yet\n-- (line 18, announced for December 2026) are left out.\nWITH stations AS (\n  SELECT res_com, max(date_mise) AS last_opened\n  FROM read_parquet('http://feeds/idfm/emplacement-des-gares-idf.parquet')\n  WHERE mode = 'METRO'\n  GROUP BY res_com\n), segments AS (\n  SELECT coalesce(t.date_mes, s.last_opened) AS opened,\n         'Line ' || t.indice_lig AS line,\n         '#' || upper(t.colourweb_hexa) AS color,\n         t.geo_shape::GEOMETRY AS g\n  FROM read_parquet('http://feeds/idfm/traces-du-reseau-ferre-idf.parquet') t\n  LEFT JOIN stations s USING (res_com)\n  WHERE t.mode = 'METRO'\n)\nSELECT opened::TIMESTAMP AS time,\n       line,\n       color,\n       year(opened) AS opened_in,\n       round(ST_Length_Spheroid(ST_FlipCoordinates(g)) / 1000, 3) AS km,\n       ST_AsGeoJSON(g)::VARCHAR AS geojson\nFROM segments\nWHERE opened \u003c= now()\nORDER BY time",
                  "refId": "segments"
                },
                "type": "datasource"
              }
            },
            "version": "v0"
          },
          "refresh": "onDashboardLoad",
          "regex": "",
          "regexApplyTo": "value",
          "skipUrlSync": false,
          "sort": "disabled"
        }
      },
      {
        "kind": "QueryVariable",
        "spec": {
          "allowCustomValue": true,
