          "label": "Every year for every line",
          "multi": false,
          "name": "calendar",
          "options": [],
          "query": {
            "datasource": {
              "name": "duckdbwasm"
            },
            "group": "ubica-chaski-datasource",
            "kind": "DataQuery",
            "spec": {
              "kind": "dataset",
              "name": "calendar",
              "refId": "calendar",
              "source": {
                "sql": "-- In your browser: the first of January of every year since 1900, for every\n-- line. Filtered by the same selection as the segments (a clause on time, one\n-- on line), its latest year is where the timeline's window ends, at the same\n-- pace as the other cards.\nSELECT make_timestamp(y::BIGINT, 1, 1, 0, 0, 0) AS time, l.line\nFROM range(1900, year(now()) + 1) AS t(y), (SELECT DISTINCT line FROM $segments) AS l",
                "type": "sql"
              }
            },
            "version": "v0"
          },
          "refresh": "onDashboardLoad",
