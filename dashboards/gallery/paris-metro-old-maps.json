                "spec": "# Kilometres opened in each five years, stacked by line. The timeline's window and the\n# lines picked filter it: play the timeline and the years fill in.\nparams:\n  metroFilters: { select: crossfilter }\nplot:\n  - mark: rectY\n    data: { from: segments, filterBy: $metroFilters }\n    x: { bin: time, interval: year, step: 5 }\n    y: { sum: km }\n    fill: line\n    inset: 0.5\nxDomain: Fixed\nyDomain: Fixed\nxLabel: null\nyLabel: ↑ km opened\nmarginLeft: 40\ncolorDomain: ['Line 1', 'Line 2', 'Line 3', 'Line 3bis', 'Line 4', 'Line 5', 'Line 6', 'Line 7', 'Line 7bis', 'Line 8', 'Line 9', 'Line 10', 'Line 11', 'Line 12', 'Line 13', 'Line 14']\ncolorRange: ['#FFBE00', '#0055C8', '#6E6E00', '#82C8E6', '#A0006E', '#FF5A00', '#82DC73', '#FF82B4', '#82DC73', '#D282BE', '#D2D200', '#DC9600', '#6E491E', '#00643C', '#82C8E6', '#640082']\n",
                "variables": ""
              }
            },
            "version": "2.2.0"
          }
        }
      }
