      "panel-map": {
        "kind": "Panel",
        "spec": {
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "hidden": false,
                    "query": {
                      "datasource": {
                        "name": "duckdbwasm"
                      },
                      "group": "ubica-chaski-datasource",
                      "kind": "DataQuery",
                      "spec": {
                        "rawSql": "-- Every segment, whatever the timeline holds: the map filters itself on the\n-- GPU from the metroFilters selection (mosaicSelection), with no query.\nSELECT time, line, color, opened_in::INTEGER AS opened_in, km, geojson\nFROM $segments"
                      },
                      "version": "v0"
                    },
                    "refId": "A"
                  }
                },
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "hidden": false,
                    "query": {
                      "datasource": {
                        "name": "duckdbwasm"
                      },
                      "group": "ubica-chaski-datasource",
                      "kind": "DataQuery",
                      "spec": {
                        "rawSql": "-- The old map: one layer of IGN's Géoplateforme WMS, picked above. The\n-- browser asks the service for the pictures itself (it allows any origin);\n-- nothing is stored here.\nSELECT 'https://data.geopf.fr/wms-r/wms' AS wms_url, $oldmap AS wms_layer"
                      },
                      "version": "v0"
                    },
                    "refId": "B"
                  }
                },
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "hidden": false,
                    "query": {
                      "datasource": {
                        "name": "duckdbwasm"
                      },
                      "group": "ubica-chaski-datasource",
                      "kind": "DataQuery",
                      "spec": {
                        "rawSql": "-- Every station, filtered on the GPU like the lines: the selection's clauses\n-- are on time and line, which the stations have too.\nSELECT time, station, line, opened_in::INTEGER AS opened_in, latitude, longitude\nFROM $stations"
                      },
                      "version": "v0"
                    },
                    "refId": "C"
                  }
                }
              ],
              "queryOptions": {},
              "transformations": []
            }
          },
          "description": "The Métro lines and stations open in the timeline's window, on the old map picked (IGN's WMS). Lines in their official colours (Île-de-France Mobilités), stations as white dots. Play the timeline to watch the network grow; pick lines in Line by line.",
          "id": 1,
          "links": [],
          "title": "The Métro on ${oldmap:text}",
