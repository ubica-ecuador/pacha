          "options": [],
          "query": "Cassini · 18th century : BNF-IGNF_GEOGRAPHICALGRIDSYSTEMS.CASSINI,Cassini · the king's copy : AN-IGNF_GEOGRAPHICALGRIDSYSTEMS.CASSINI,État-major · 1820–1866 : GEOGRAPHICALGRIDSYSTEMS.ETATMAJOR40,IGN · 1950 : GEOGRAPHICALGRIDSYSTEMS.MAPS.SCAN50.1950",
          "skipUrlSync": false,
          "valuesFormat": "csv"
        }
